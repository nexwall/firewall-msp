START=99

# Secure by default, once: see /usr/sbin/nexwall-secure-defaults. Runs in the background (it waits for the API).
start() {
	[ -f /etc/nexwall/secure-defaults.done ] && return 0
	( /usr/sbin/nexwall-secure-defaults >/dev/null 2>&1 & )
}

boot() {
	start
}
