"""
nexwall-webui-cert - a certificate the browser trusts for the web interface of this firewall.

The administrator opens https://firewall.lan.nexwall.com.br (or https://<serial>.lan.nexwall.com.br). This firewall answers
those names itself (static DNS entries pointing to its own LAN address, kept current by this tool) and presents a Let's Encrypt
certificate that belongs to this unit alone: the unit makes its own private key (it never leaves the unit), asks the Nexwall
license server for a certificate for its two names, and installs what comes back:

  - the answer is signed by the license server; the certificate must carry the unit's names and belong to the unit's own key;
  - Let's Encrypt validates through DNS, so the unit has to be online only for the request (a minute); renewal starts 28 days
    before the certificate ends;
  - a unit whose server cannot issue yet (older server, no answer) falls back to the shared certificate of
    firewall.nexwall.com.br that older firmware used, and tries the own certificate again at the next run.

Everything below about the shared certificate describes that fallback:

  - the answer is signed by the license server and is only accepted when it is for firewall.nexwall.com.br, the certificate
    is valid for that name, is not about to expire and belongs to the private key that came with it;
  - until a valid certificate is installed, and whenever it stops being valid (expired, or the server cannot be reached for
    too long), the web interface keeps using - or goes back to - its own self-signed certificate, so it is always reachable;
  - opening the web interface by IP address (https://192.168.1.1) cannot be trusted by a browser: no public authority issues
    certificates for private addresses. The browser warns, as it always did.

  nexwall-webui-cert sync       static DNS entry + download/renew the certificate (cron, every few hours, and at boot)
  nexwall-webui-cert status     what is installed (JSON)
  nexwall-webui-cert dns        only the static DNS entry
  nexwall-webui-cert revert     go back to the self-signed certificate
  nexwall-webui-cert install FULLCHAIN KEY    install a certificate that was provided by hand (same checks)
"""

import argparse
import base64
import datetime
import json
import os
import re
import subprocess
import sys
import tempfile
import time

HOSTNAME = 'firewall.nexwall.com.br'          # the shared certificate of earlier firmware (fallback)
ZONE = 'lan.nexwall.com.br'
GENERIC = 'firewall.' + ZONE                  # the same short name on every label
ACCEPTED = (GENERIC, HOSTNAME)                # a certificate must carry one of these
SERIAL_FILE = '/etc/nexwall-license/serial'
UNIT_KEY = '/etc/nexwall/webui-cert/unit.key'
RENEW_DAYS = 28
DIR = '/etc/nexwall/webui-cert'
CHAIN = os.path.join(DIR, 'fullchain.pem')
KEY = os.path.join(DIR, 'privkey.pem')
SELF_CRT = '/etc/nginx/conf.d/_lan.crt'
SELF_KEY = '/etc/nginx/conf.d/_lan.key'
CORE_CTL = '/usr/sbin/licensectl'
PUBKEY = '/etc/nexwall-license/pubkey.pem'
MIN_DAYS_LEFT = 1                 # a certificate that expires sooner than this is not installed
NOW_FLOOR = 1735689600            # 2025-01-01: a clock before this has not been set yet, expiry cannot be judged


def log(msg):
    print(msg, file=sys.stderr)
    subprocess.run(['logger', '-t', 'nexwall-webui-cert', msg], check=False)


def run(cmd, stdin=None, timeout=60):
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)


def uci(key, default=''):
    p = run(['uci', '-q', 'get', key])
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else default


# ---------------------------------------------------------------- static DNS entry

def lan_address():
    """The LAN address of this firewall (the first address of the 'lan' interface)."""
    value = uci('network.lan.ipaddr')
    if not value:
        p = run(['uci', '-q', 'get', 'network.lan.ipaddr'])
        value = p.stdout.split()[0] if p.stdout.split() else ''
    return value.split('/')[0].strip("'") if value else ''


def unit_name():
    """<serial>.lan.nexwall.com.br of this unit, '' when the serial is not known."""
    try:
        serial = open(SERIAL_FILE).read().strip().upper()
    except OSError:
        return ''
    return serial.lower() + '.' + ZONE if re.match(r'^NXW-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$', serial) else ''


def ensure_dns():
    """The names of the web interface -> the LAN address of this unit, in the DNS server of the firewall. True when changed."""
    ip = lan_address()
    if not ip:
        return False
    changed = False
    for section, name in (('nexwall_webui', HOSTNAME), ('nexwall_webui_lan', GENERIC), ('nexwall_webui_unit', unit_name())):
        if not name or (uci('dhcp.%s.name' % section) == name and uci('dhcp.%s.ip' % section) == ip):
            continue
        run(['uci', 'set', 'dhcp.%s=domain' % section])
        run(['uci', 'set', 'dhcp.%s.name=%s' % (section, name)])
        run(['uci', 'set', 'dhcp.%s.ip=%s' % (section, ip)])
        log('%s now points to %s' % (name, ip))
        changed = True
    if changed:
        run(['uci', 'commit', 'dhcp'])
        run(['/etc/init.d/dnsmasq', 'reload'])
    return changed


# ---------------------------------------------------------------- certificate checks

def cert_info(path):
    """-> dict(not_after=epoch, names=[...], pubkey=PEM) or raises ValueError."""
    p = run(['openssl', 'x509', '-in', path, '-noout', '-enddate', '-ext', 'subjectAltName'])
    if p.returncode != 0:
        raise ValueError('not a certificate')
    m = re.search(r'notAfter=(.+)', p.stdout)
    if not m:
        raise ValueError('no expiry date')
    not_after = int(datetime.datetime.strptime(m.group(1).strip(), '%b %d %H:%M:%S %Y %Z')
                    .replace(tzinfo=datetime.timezone.utc).timestamp())
    names = re.findall(r'DNS:([^\s,]+)', p.stdout)
    pub = run(['openssl', 'x509', '-in', path, '-noout', '-pubkey']).stdout
    return {'not_after': not_after, 'names': [n.lower() for n in names], 'pubkey': pub}


def key_pubkey(path):
    p = run(['openssl', 'pkey', '-in', path, '-pubout'])
    if p.returncode != 0:
        raise ValueError('not a private key')
    return p.stdout


def check_pair(chain_path, key_path):
    """The certificate is for our name, is not about to expire, and its private key is the one given. Returns the info."""
    info = cert_info(chain_path)
    if not any(n in info['names'] for n in ACCEPTED):
        raise ValueError('the certificate is not for %s' % GENERIC)
    if time.time() > NOW_FLOOR and info['not_after'] < time.time() + MIN_DAYS_LEFT * 86400:
        raise ValueError('the certificate is expired or about to expire')
    if key_pubkey(key_path) != info['pubkey']:
        raise ValueError('the private key does not belong to the certificate')
    return info


def verify_signature(resp, kind='webui-certificate'):
    from Crypto.Hash import SHA256
    from Crypto.PublicKey import RSA
    from Crypto.Signature import pkcs1_15
    with open(PUBKEY, 'rb') as f:
        key = RSA.import_key(f.read())
    payload = base64.b64decode(resp['payload'])
    pkcs1_15.new(key).verify(SHA256.new(payload), base64.b64decode(resp['signature']))
    data = json.loads(payload)
    if data.get('kind') != kind or (kind == 'webui-certificate' and data.get('hostname') != HOSTNAME):
        raise ValueError('not a web interface certificate answer')
    return data


# ---------------------------------------------------------------- web server

def nginx_uses():
    return uci('nginx._lan.ssl_certificate')


def restart_web():
    """Regenerate the web server configuration and restart it (ns-ui does both); True when it answers on 443 afterwards."""
    run(['/usr/sbin/ns-ui'], timeout=120)
    for _ in range(10):
        time.sleep(1)
        if run(['sh', '-c', "curl -sk -o /dev/null -m 5 https://127.0.0.1/ && echo ok"]).stdout.strip() == 'ok':
            return True
    return False


def use_own(chain=CHAIN, key=KEY):
    run(['uci', 'set', 'nginx._lan.ssl_certificate=%s' % chain])
    run(['uci', 'set', 'nginx._lan.ssl_certificate_key=%s' % key])
    run(['uci', '-q', 'delete', 'nginx._lan.uci_manage_ssl'])
    run(['uci', 'commit', 'nginx'])


def use_self_signed():
    run(['uci', 'set', 'nginx._lan.ssl_certificate=%s' % SELF_CRT])
    run(['uci', 'set', 'nginx._lan.ssl_certificate_key=%s' % SELF_KEY])
    run(['uci', 'set', 'nginx._lan.uci_manage_ssl=self-signed'])
    run(['uci', 'commit', 'nginx'])


def revert():
    use_self_signed()
    ok = restart_web()
    log('back to the self-signed certificate (web interface %s)' % ('answers' if ok else 'DOES NOT ANSWER'))
    return ok


def same_file(path, data):
    try:
        with open(path) as f:
            return f.read() == data
    except OSError:
        return False


def install(fullchain, privkey):
    """Check and install a certificate + key pair, and point the web server at it. Returns 'installed' or 'unchanged'."""
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    if same_file(CHAIN, fullchain) and same_file(KEY, privkey) and nginx_uses() == CHAIN:
        check_pair(CHAIN, KEY)
        return 'unchanged'
    tmp = tempfile.mkdtemp(dir=DIR)
    try:
        c, k = os.path.join(tmp, 'fullchain.pem'), os.path.join(tmp, 'privkey.pem')
        with open(c, 'w') as f:
            f.write(fullchain)
        fd = os.open(k, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(privkey)
        check_pair(c, k)
        os.replace(k, KEY)
        os.replace(c, CHAIN)
    finally:
        for name in os.listdir(tmp):
            os.unlink(os.path.join(tmp, name))
        os.rmdir(tmp)
    os.chmod(KEY, 0o600)
    use_own()
    if not restart_web():
        log('the web interface does not answer with the new certificate: going back')
        revert()
        raise RuntimeError('the new certificate could not be used')
    info = cert_info(CHAIN)
    log('certificate installed for %s, valid until %s' % (', '.join(n for n in info['names'] if n in ACCEPTED or n == unit_name()), datetime.datetime.fromtimestamp(info['not_after'], datetime.timezone.utc).date()))
    return 'installed'


def installed_status():
    out = {'hostname': GENERIC, 'unit_name': unit_name(), 'lan_address': lan_address(), 'dns_entry': uci('dhcp.nexwall_webui_lan.ip'),
           'using': 'nexwall' if nginx_uses() == CHAIN else 'self-signed', 'valid': False, 'mode': 'none'}
    if os.path.exists(CHAIN) and os.path.exists(KEY):
        try:
            info = check_pair(CHAIN, KEY)
            out.update({'valid': True, 'not_after': info['not_after'], 'names': info['names'],
                        'mode': 'unit' if GENERIC in info['names'] else 'shared'})
        except (ValueError, OSError) as e:
            out['error'] = str(e)
    return out


# ---------------------------------------------------------------- commands

OK_STAMP = os.path.join(DIR, 'last-ok')
RECHECK_SECONDS = 4 * 3600        # a valid certificate is looked up again this often


def recently_checked():
    st = installed_status()
    try:
        return st['valid'] and st['using'] == 'nexwall' and time.time() - os.path.getmtime(OK_STAMP) < RECHECK_SECONDS
    except OSError:
        return False


def ensure_unit_key():
    """The private key of this unit (EC P-256), made once, mode 0600; it never leaves the unit."""
    if not os.path.exists(UNIT_KEY):
        os.makedirs(DIR, mode=0o700, exist_ok=True)
        tmp = UNIT_KEY + '.new'
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.close(fd)
        p = run(['openssl', 'ecparam', '-name', 'prime256v1', '-genkey', '-noout', '-out', tmp])
        if p.returncode != 0:
            raise RuntimeError('cannot make the private key: %s' % p.stderr.strip())
        os.replace(tmp, UNIT_KEY)
    os.chmod(UNIT_KEY, 0o600)


def make_csr():
    """The certificate request for both names, DER, base64url (it travels in the address of a GET request)."""
    own = unit_name()
    if not own:
        raise RuntimeError('the serial number of this unit is not known yet')
    p = subprocess.run(['openssl', 'req', '-new', '-key', UNIT_KEY, '-subj', '/CN=%s' % GENERIC, '-addext',
                        'subjectAltName=DNS:%s,DNS:%s' % (GENERIC, own), '-outform', 'DER'], capture_output=True, timeout=30)
    if p.returncode != 0:
        raise RuntimeError('cannot make the certificate request: %s' % p.stderr.decode(errors='replace').strip())
    return base64.urlsafe_b64encode(p.stdout).decode().rstrip('=')


def days_left():
    try:
        return (check_pair(CHAIN, KEY)['not_after'] - time.time()) / 86400
    except (ValueError, OSError):
        return -1


def unit_cert_current():
    """True when the installed certificate is this unit's own, valid and not due for renewal."""
    st = installed_status()
    return st['valid'] and st['using'] == 'nexwall' and st['mode'] == 'unit' and \
        open(KEY).read() == open(UNIT_KEY).read() and days_left() > RENEW_DAYS


def sync_unit():
    """Ask the license server for this unit's own certificate and install it. Returns 'installed', 'unchanged' or raises."""
    ensure_unit_key()
    csr = make_csr()
    deadline = time.time() + 150
    while True:
        p = subprocess.run([CORE_CTL, 'get', '/api/v1/webui-cert/issue?csr=' + csr], capture_output=True, timeout=120)
        if p.returncode != 0:
            raise RuntimeError(p.stderr.decode(errors='replace').strip() or 'request failed')
        answer = json.loads(p.stdout)
        if answer.get('status') == 'ready':
            data = verify_signature(answer, 'webui-certificate-issued')
            if unit_name() not in data['names'] or GENERIC not in data['names']:
                raise ValueError('the certificate is not for the names of this unit')
            return install(data['fullchain'], open(UNIT_KEY).read())
        if answer.get('status') == 'error':
            raise RuntimeError('the server could not issue the certificate: %s %s' % (answer.get('code'), answer.get('detail', '')))
        if time.time() > deadline:
            raise RuntimeError('the certificate is still being issued, the next run asks again')
        time.sleep(10)


def cmd_sync(args):
    ensure_dns()
    # the schedule runs every half hour so that a new unit gets its certificate soon after its license registration
    force = getattr(args, 'force', False)
    if not force and unit_cert_current():
        return 0
    try:
        result = sync_unit()
        print(result)
        return 0
    except Exception as e:  # noqa: BLE001 - the shared certificate or the self-signed one keep the web interface working
        log('could not get the own certificate: %s' % e)
    # fallback: a unit that has no valid certificate takes the shared one of earlier firmware, until the own one is ready
    if not force and installed_status()['valid'] and installed_status()['using'] == 'nexwall':
        return 1
    if not force and recently_checked():
        return 0
    try:
        p = subprocess.run([CORE_CTL, 'get', '/api/v1/webui-cert'], capture_output=True, timeout=120)
        if p.returncode != 0:
            raise RuntimeError(p.stderr.decode(errors='replace').strip() or 'request failed')
        data = verify_signature(json.loads(p.stdout))
        result = install(data['fullchain'], data['privkey'])
        with open(OK_STAMP, 'w') as f:
            f.write(str(int(time.time())))
        print(result)
        return 0
    except Exception as e:  # noqa: BLE001 - whatever happens, the web interface keeps working
        log('could not get the certificate: %s' % e)
        st = installed_status()
        # a certificate that is no longer valid must not stay in use
        if st['using'] == 'nexwall' and not st['valid']:
            revert()
        return 1


def cmd_status(_args):
    print(json.dumps(installed_status()))
    return 0


def cmd_dns(_args):
    ensure_dns()
    return 0


def cmd_revert(_args):
    return 0 if revert() else 1


def cmd_install(args):
    with open(args.fullchain) as f:
        chain = f.read()
    with open(args.key) as f:
        key = f.read()
    ensure_dns()
    try:
        print(install(chain, key))
    except (ValueError, RuntimeError) as e:
        print('not installed: %s' % e, file=sys.stderr)
        return 1
    return 0


def main():
    parser = argparse.ArgumentParser(description='Certificate of the web interface')
    sub = parser.add_subparsers(dest='cmd', required=True)
    sp = sub.add_parser('sync')
    sp.add_argument('--force', action='store_true')
    sp.set_defaults(func=cmd_sync)
    sub.add_parser('status').set_defaults(func=cmd_status)
    sub.add_parser('dns').set_defaults(func=cmd_dns)
    sub.add_parser('revert').set_defaults(func=cmd_revert)
    p = sub.add_parser('install')
    p.add_argument('fullchain')
    p.add_argument('key')
    p.set_defaults(func=cmd_install)
    args = parser.parse_args()
    return args.func(args)


if __name__ == '__main__':
    sys.exit(main())
