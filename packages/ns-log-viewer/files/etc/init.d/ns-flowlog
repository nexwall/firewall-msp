# Traffic and application records for the Log Viewer. Enabled and started together with the viewer (ns.log-viewer enable),
# idle while the page is closed.
USE_PROCD=1
START=98
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/ns-flowlog
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
