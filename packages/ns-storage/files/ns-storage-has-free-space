# Check for free space on the OS partition
# Parameters:
#  - preserve, disk space to preserve for future use; optional, default to 100MiB

set -e

part=$(lsblk -ln | grep "/rom" | uniq | awk '{print $1}')
dev="/dev/$(lsblk -lno pkname /dev/$part)"
# same default as ns-storage-setup-partition: 100 MiB plus the root slot size (slot B) on disks of 16 GiB or more
root_mib=$(( $(lsblk -bno SIZE "/dev/$part" | head -n 1) / 1048576 ))
disk_mib=$(( $(lsblk -bdno SIZE "$dev") / 1048576 ))
if [ "$disk_mib" -ge 16384 ] && [ "$root_mib" -gt 0 ] && [ "$root_mib" -le 4096 ]; then
    default_preserve=$(( root_mib + 100 ))
else
    default_preserve=100
fi
preserve=${1:-$default_preserve}

pnum=$(lsblk ${dev} -o TYPE -n | grep part | wc -l)
if [ "${pnum}" -gt 3 ]; then
    # already partitioned, no free space
    exit 3
fi

# find free space
free_part=$(parted -s -m "${dev}" unit B print free 2>/dev/null | grep free | tail -n -1)

if [ -z "${free_part}" ]; then
    # no free space
    exit 4
fi

size=$(echo "${free_part}" | awk -F':' '{print $4}')
size=${size::-1}

# convert from MiB to B
preserve=$(( preserve * 8388608 / 8 ))
size=$(( size - preserve ))

if [ "$size" -le 0 ]; then
    # not enough free space
    exit 5
fi

echo '{"name": "'$(basename $dev)'", "path": "'$dev'", "size": '$size'}'
