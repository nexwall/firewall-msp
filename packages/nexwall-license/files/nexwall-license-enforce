# Brings the running configuration in line with what the current license includes. It is the
# counterpart of the checks in the ns.* APIs: those refuse to create or enable things the license does
# not cover, this switches off what is already running when the license changes underneath it
# (trial ended, subscription lapsed, license revoked).
#
# Rules:
#  - it only ever switches things OFF. Configuration is kept, so an administrator can turn a service
#    back on once the unit is licensed again; nothing is re-enabled automatically.
#  - idempotent and cheap: with nothing to do it only reads the license and a few UCI options.
#  - reverse proxy and HA carry live traffic or a failover pair, so they are not cut at once: when the
#    license stops covering them a grace period starts (default 7 days, uci nexwall-license.main.grace_days),
#    the unit logs it, and only when it runs out they are switched off (HA: this node only). The grace
#    clock is kept in enforced.json and cleared as soon as the license covers the feature again.
#    Creating or changing them is refused by the API from the first minute.
#
# Usage: nexwall-license-enforce [--dry-run]
import json
import subprocess
import sys
from datetime import datetime, timedelta, timezone

from euci import EUci
from nethsec import license as nx_license
from nethsec import utils

DRY = '--dry-run' in sys.argv[1:]
STATE_FILE = '/etc/nexwall-license/enforced.json'
GRACE_DAYS_DEFAULT = 7
acted = []
to_run = []   # commands to run after the commit, in order
to_stop = []  # init scripts to stop explicitly: a config reload alone does not unload their rules


def log(msg):
    print(msg)
    subprocess.run(['logger', '-t', 'nexwall-license-enforce', msg], check=False)


def rpc(script, action, payload=None):
    p = subprocess.run([f'/usr/libexec/rpcd/{script}', 'call', action], input=json.dumps(payload or {}),
                       capture_output=True, text=True, timeout=180)
    try:
        return json.loads(p.stdout)
    except ValueError:
        return {}


def pending_configs():
    # configs with staged (saved but not committed) changes
    out = subprocess.run(['uci', 'changes'], capture_output=True, text=True).stdout
    return {line.lstrip('-+').split('.')[0] for line in out.splitlines() if line.strip()}


def commit_staged(before):
    """The ns.* APIs only stage their changes (the UI commits afterwards): commit what they staged
    for us, and only that - changes an administrator had pending before are left alone."""
    done = sorted(pending_configs() - before)
    for cfg in done:
        subprocess.run(['uci', 'commit', cfg], check=False)
    return done


def failed(res):
    return isinstance(res, dict) and ('error' in res or 'validation' in res)


def record(what):
    acted.append(what)
    log(('would switch off: ' if DRY else 'switched off: ') + what)


def enforce_security_services(u):
    # IPS
    if u.get('snort', 'snort', 'enabled', default='0') == '1':
        record('IPS')
        if not DRY:
            u.set('snort', 'snort', 'enabled', '0')
            u.commit('snort')
    # DPI: rules are what enforce it; keep them, just disabled
    dpi_rules = utils.get_all_by_type(u, 'dpi', 'rule')
    on = [r for r in dpi_rules if u.get('dpi', r, 'enabled', default='0') == '1']
    if on:
        record(f'DPI rules ({len(on)})')
        # regenerate the flow-action config, then restart netifyd: its plugin only reads that
        # config at start, a reload would keep blocking with the old rules
        to_run.extend([['/etc/init.d/dpi', 'reload'], ['/etc/init.d/netifyd', 'restart']])
        if not DRY:
            for r in on:
                u.set('dpi', r, 'enabled', '0')
            u.commit('dpi')
    # IP & Geo Blocking (banIP), DNS filtering (adblock), category filtering: use the same code paths as the UI
    if u.get('banip', 'global', 'ban_enabled', default='0') == '1':
        record('IP blocking')
        to_stop.append('banip')
        if not DRY:
            failed(rpc('ns.threatshield', 'edit-settings', {'enabled': False}))
    if u.get('adblock', 'global', 'adb_enabled', default='0') == '1':
        record('DNS filtering')
        to_stop.append('adblock')
        if not DRY:
            rpc('ns.threatshield', 'dns-edit-settings', {'enabled': False})
    geo = rpc('ns.threatshield', 'geoblocking-configuration')
    if isinstance(geo, dict) and geo.get('enabled'):
        record('geo blocking')
        if not DRY:
            # keep the selected countries so turning it back on later loses nothing
            rpc('ns.threatshield', 'set-geoblocking-configuration',
                {'enabled': False, 'countries': geo.get('blocked_regions') or []})
    fs = rpc('ns.flashstart', 'get-config')
    if isinstance(fs, dict) and (fs.get('values') or {}).get('enabled'):
        record('category filtering')
        if not DRY:
            rpc('ns.flashstart', 'set-config', {'enabled': False})


def enforce_ipsec(u, allowed):
    remotes = [r for r in utils.get_all_by_type(u, 'ipsec', 'remote')
               if u.get('ipsec', r, 'enabled', default='1') == '1']
    for r in remotes[allowed:]:
        record(f'IPsec tunnel {r} (limit {allowed})')
        if not DRY:
            rpc('ns.ipsectunnel', 'disable-tunnel', {'id': r})


def enforce_wireguard(u, allowed):
    wg = [i for i, o in utils.get_all_by_type(u, 'network', 'interface').items()
          if o.get('proto') == 'wireguard' and o.get('disabled', '0') != '1']
    for i in wg[allowed:]:
        record(f'WireGuard {i} (limit {allowed})')
        if not DRY:
            u.set('network', i, 'disabled', '1')
            u.commit('network')
            subprocess.run(['ifdown', i], capture_output=True, check=False)


def enforce_sslvpn(u, allowed):
    accounts = [(uid, user) for uid, user in utils.get_all_by_type(u, 'users', 'user').items()
                if user.get('openvpn_enabled') == '1']
    extra = accounts[allowed:]
    if not extra:
        return
    instances = [i for i, o in utils.get_all_by_type(u, 'openvpn', 'openvpn').items()
                 if 'automated' in (o.get('ns_tag') or [])]
    for uid, user in extra:
        record(f"SSL VPN account {user.get('name', uid)} (limit {allowed})")
        if not DRY:
            u.set('users', uid, 'openvpn_enabled', '0')
            for inst in instances:  # drop the live session, ignore errors
                subprocess.run(['/usr/bin/openvpn-kill', f'/var/run/openvpn_{inst}.socket', user.get('name', '')],
                               capture_output=True, check=False)
    if not DRY:
        u.commit('users')


def load_state():
    try:
        with open(STATE_FILE) as f:
            data = json.load(f)
            return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def reverse_proxy_in_use(u):
    for name, o in utils.get_all_by_type(u, 'nginx', 'server').items():
        if o.get('uci_description') is not None and o.get('uci_enable', 'true') != 'false':
            return True
    includes = list(u.get('nginx', '_lan', 'include', default=[], list=True))
    return 'conf.d/_lan[.]proxy' in includes


def stop_reverse_proxy(u):
    for name, o in utils.get_all_by_type(u, 'nginx', 'server').items():
        if o.get('uci_description') is not None and o.get('uci_enable', 'true') != 'false':
            u.set('nginx', name, 'uci_enable', 'false')
    includes = [i for i in u.get('nginx', '_lan', 'include', default=[], list=True) if i != 'conf.d/_lan[.]proxy']
    if includes:
        u.set('nginx', '_lan', 'include', includes)
    else:
        try:
            u.delete('nginx', '_lan', 'include')
        except Exception:
            pass
    u.commit('nginx')
    to_run.append(['/etc/init.d/ns-reverse-proxy', 'restart'])


def ha_in_use(u):
    return u.get('keepalived', 'globals', 'enabled', default='0') == '1'


def stop_ha(u):
    u.set('keepalived', 'globals', 'enabled', '0')
    u.commit('keepalived')
    to_stop.append('keepalived')


def enforce_grace(u, ent, now=None):
    """Reverse proxy and HA: warn first, switch off only when the grace period has run out."""
    now = now or datetime.now(timezone.utc)
    days = int(u.get('nexwall-license', 'main', 'grace_days', default=GRACE_DAYS_DEFAULT) or GRACE_DAYS_DEFAULT)
    state = load_state()
    grace = state.get('grace') if isinstance(state.get('grace'), dict) else {}
    changed = False
    for feature, in_use, stop, label in (('reverse_proxy', reverse_proxy_in_use, stop_reverse_proxy, 'reverse proxy'),
                                         ('ha', ha_in_use, stop_ha, 'high availability')):
        if ent.get(feature) or not in_use(u):
            if feature in grace:  # covered again, or not in use any more: forget the clock
                del grace[feature]
                changed = True
            continue
        started = nx_license._ts(grace.get(feature))
        if started is None:
            started = now
            grace[feature] = now.isoformat()
            changed = True
            log(f'{label} is not covered by the license: grace period of {days} days started')
        end = started + timedelta(days=days)
        if now >= end:
            record(f'{label} (grace period ended {end.date()})')
            if not DRY:
                stop(u)
            del grace[feature]
            changed = True
        else:
            print(f'{label}: not covered by the license, switched off after {end.date()}')
    if changed and not DRY:
        state['grace'] = grace
        state['state'] = nx_license.state()
        try:
            with open(STATE_FILE, 'w') as f:
                json.dump(state, f, indent=2)
        except OSError:
            pass
    return state


def main():
    ent = nx_license.entitlements()
    u = EUci()
    before = pending_configs()
    if not ent['security_services']:
        enforce_security_services(u)
    enforce_grace(u, ent)
    lim = ent['limits']
    if lim.get('ipsec_s2s') is not None:
        enforce_ipsec(u, lim['ipsec_s2s'])
    if lim.get('wireguard') is not None:
        enforce_wireguard(u, lim['wireguard'])
    if lim.get('sslvpn_users') is not None:
        enforce_sslvpn(u, lim['sslvpn_users'])

    if acted and not DRY:
        commit_staged(before)
        # commits made through uci do not notify services: do what the UI's apply does
        subprocess.run(['/sbin/reload_config'], capture_output=True, timeout=300, check=False)
        for svc in to_stop:
            subprocess.run([f'/etc/init.d/{svc}', 'stop'], capture_output=True, timeout=300, check=False)
        for cmd in to_run:
            subprocess.run(cmd, capture_output=True, timeout=300, check=False)
        try:
            state = load_state()
            state.update({'state': nx_license.state(), 'switched_off': acted})
            with open(STATE_FILE, 'w') as f:
                json.dump(state, f, indent=2)
        except OSError:
            pass
    if not acted:
        print('nothing to enforce (state: %s)' % nx_license.state())


if __name__ == '__main__':
    main()
