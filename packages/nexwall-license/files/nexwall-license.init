# Copyright (C) 2026 Nexwall
# SPDX-License-Identifier: GPL-2.0-only

START=99
USE_PROCD=1

start_service() {
	# the license core is a vendor binary: present in the official image, absent in a community build
	# (then the unit simply runs with the limited feature set)
	[ -x /usr/sbin/nexwall-licensed ] || return 0
	# checks in on its own schedule (retrying until the network is up), answers the rest of the system over
	# /var/run/nexwall-license.sock, applies the entitlements and keeps itself current from the vendor feed
	procd_open_instance
	procd_set_param command /usr/sbin/nexwall-licensed daemon
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
