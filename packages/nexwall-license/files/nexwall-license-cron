#
# Refresh the license daily (in addition to whatever an admin triggers
# manually via nexwall-license-register) so a subscription change,
# expiry, or revocation on the server is reflected here within a day,
# not only at next reboot.

crontab -l 2>/dev/null | grep -q 'nexwall-license-register' || \
  echo '41 5 * * * sleep $(( RANDOM % 1800 )); /usr/sbin/nexwall-license-register' >> /etc/crontabs/root

exit 0
