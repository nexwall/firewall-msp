import os
import subprocess
import sys
from euci import EUci
from jinja2 import Environment, BaseLoader

# Connections matched by ns-dpi-bridge are added to these sets; the chain rejects them
# or changes their priority. The rules are validated before they replace the old ones,
# because an invalid snippet would prevent the firewall from loading.
RULES = """
{% for family, kind in (('4', 'ipv4_addr'), ('6', 'ipv6_addr')) -%}
{% for action in actions -%}
set dpi_{{ action }}{{ family }} {
    type {{ kind }} . {{ kind }} . inet_proto . inet_service . inet_service
    flags timeout
    size 65535
}
{% endfor -%}
{% endfor -%}
chain dpi_actions {
    type filter hook prerouting priority filter + 10; policy accept;
{%- for family, ip in (('4', 'ip'), ('6', 'ip6')) %}
{%- if log_enabled %}
    {{ ip }} saddr . {{ ip }} daddr . meta l4proto . th sport . th dport @dpi_block{{ family }} counter log prefix "DPI block: " limit rate 1/second
{%- endif %}
    {{ ip }} saddr . {{ ip }} daddr . meta l4proto . th sport . th dport @dpi_block{{ family }} counter reject
{%- for action, dscp in qos %}
    {{ ip }} saddr . {{ ip }} daddr . meta l4proto . th sport . th dport @dpi_{{ action }}{{ family }} counter {{ ip }} dscp set {{ dscp }} return
{%- endfor %}
{%- endfor %}
}
"""

ACTIONS = ['block', 'bulk', 'best_effort', 'video', 'voice']
QOS = [('bulk', 'cs1'), ('best_effort', 'cs0'), ('video', 'af41'), ('voice', 'cs6')]


def render():
    e_uci = EUci()
    template = Environment(loader=BaseLoader()).from_string(RULES)
    return template.render(
        actions=ACTIONS,
        qos=QOS,
        log_enabled=e_uci.get('dpi', 'config', 'log_blocked', dtype=bool, default=False)
    )


def is_valid(rules):
    check = 'table inet ns_dpi_check {\n' + rules + '\n}\n'
    result = subprocess.run(['nft', '-c', '-f', '-'], input=check, text=True, capture_output=True)
    return result.returncode == 0, result.stderr


def generate_dpi():
    rendered = render()
    # save to nftables directory table-pre, only if the file is changed
    file_path = '/usr/share/nftables.d/table-pre/dpi_actions.nft'
    current = None
    if os.path.exists(file_path):
        with open(file_path, 'r') as f:
            current = f.read()
    if current == rendered:
        return 0
    ok, error = is_valid(rendered)
    if not ok:
        print(f'dpi-nft: invalid rules, firewall left unchanged: {error.strip()}', file=sys.stderr)
        return 1
    os.makedirs(os.path.dirname(file_path), exist_ok=True)
    with open(file_path, 'w') as f:
        f.write(rendered)
    # reload nftables
    subprocess.run(['fw4', 'reload'], check=True, capture_output=True)
    return 0


if __name__ == "__main__":
    sys.exit(generate_dpi())
