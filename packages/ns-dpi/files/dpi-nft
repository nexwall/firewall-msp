import os
import subprocess
import sys
from euci import EUci
from jinja2 import Environment, BaseLoader

RULES = """
chain dpi_dummy {
    # forces the kernel to allocate the conntrack label extension for every
    # connection up front - "ct label X" match rules silently never match
    # otherwise, for any connection whose label extension was never
    # initialized
    ct label set netify-init
}

chain dpi_actions {
    type filter hook prerouting priority filter + 10; policy accept;
{%- if log_enabled %}
    ct label netify-blocked counter log prefix "DPI block: " limit rate 1/second
{%- endif %}
    ct label netify-blocked counter reject
    ct label bulk counter ip dscp set cs1 return
    ct label best_effort counter ip dscp set cs0 return
    ct label video counter ip dscp set af41 return
    ct label voice counter ip dscp set cs6 return
}
"""


def render():
    e_uci = EUci()
    template = Environment(loader=BaseLoader()).from_string(RULES)
    return template.render(
        log_enabled=e_uci.get('dpi', 'config', 'log_blocked', dtype=bool, default=False)
    )


def is_valid(rules):
    check = 'table inet ns_dpi_check {\n' + rules + '\n}\n'
    result = subprocess.run(['nft', '-c', '-f', '-'], input=check, text=True, capture_output=True)
    return result.returncode == 0, result.stderr


def generate_dpi():
    rendered = render()
    # save to nftables directory table-pre, only if the file is changed
    file_path = '/usr/share/nftables.d/table-pre/dpi_actions.nft'
    current = None
    if os.path.exists(file_path):
        with open(file_path, 'r') as f:
            current = f.read()
    if current == rendered:
        return 0
    ok, error = is_valid(rendered)
    if not ok:
        print(f'dpi-nft: invalid rules, firewall left unchanged: {error.strip()}', file=sys.stderr)
        return 1
    os.makedirs(os.path.dirname(file_path), exist_ok=True)
    with open(file_path, 'w') as f:
        f.write(rendered)
    # reload nftables
    subprocess.run(['fw4', 'reload'], check=True, capture_output=True)
    return 0


if __name__ == "__main__":
    sys.exit(generate_dpi())
