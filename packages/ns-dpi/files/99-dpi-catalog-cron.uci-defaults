#
# Application catalog: check every 10 minutes what is due (license change, update interval), and default settings
#

grep -q '/usr/sbin/nexwall-dpi-catalog' /etc/crontabs/root 2>/dev/null || \
  echo '*/10 * * * * /usr/sbin/nexwall-dpi-catalog sync >/dev/null 2>&1' >> /etc/crontabs/root

if ! uci -q get dpi.catalog > /dev/null; then
  uci -q set dpi.catalog=catalog
  uci -q set dpi.catalog.auto_update='1'
  uci -q set dpi.catalog.interval='24'
  uci -q commit dpi
fi

# Inspection engine overload: new connections are blocked when the engine cannot keep up (strict by default)
if ! uci -q get dpi.engine > /dev/null; then
  uci -q set dpi.engine=engine
  uci -q set dpi.engine.overload_action='block'
  uci -q set dpi.engine.queue_limit='256'
  uci -q commit dpi
fi
