    | FLOW_SRC_PORT '>' VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_src_port > $3));
        _NDFP_debugf("Source port > %lu %s\n", $3, (_NDFP_result) ? "yes" : "no");
