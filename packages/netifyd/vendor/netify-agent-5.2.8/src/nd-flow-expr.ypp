    | expr_iface_nfq_dst
    | expr_intel
    | expr_tag
    | expr BOOL_OR expr {
        _NDFP_result = ($$ = ($1 || $3));
        _NDFP_debugf("OR (%d || %d == %d)\n", $1, $3, $$);
    }
    | expr BOOL_AND expr {
        _NDFP_result = ($$ = ($1 && $3));
        _NDFP_debugf("AND (%d && %d == %d)\n", $1, $3, $$);
    }
    | '(' expr ')' { _NDFP_result = ($$ = $2); }
    ;

expr_ip_proto:
      FLOW_IP_PROTO {
        _NDFP_result = ($$ = (_NDFP_flow->ip_protocol != 0));
        _NDFP_debugf(
            "IP Protocol is non-zero? %s\n", (_NDFP_result) ? "yes" : "no");
    }
    | '!' FLOW_IP_PROTO {
        _NDFP_result = ($$ = (_NDFP_flow->ip_protocol == 0));
        _NDFP_debugf("IP Protocol is zero? %s\n", (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_IP_PROTO CMP_EQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_protocol == $3));
        _NDFP_debugf("IP Protocol == %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_IP_PROTO CMP_NOTEQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_protocol != $3));
        _NDFP_debugf("IP Protocol != %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_IP_PROTO CMP_GTHANEQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_protocol >= $3));
        _NDFP_debugf("IP Protocol >= %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_IP_PROTO CMP_LTHANEQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_protocol <= $3));
        _NDFP_debugf("IP Protocol <= %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_IP_PROTO '>' VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_protocol > $3));
        _NDFP_debugf("IP Protocol > %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_IP_PROTO '<' VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_protocol < $3));
        _NDFP_debugf("IP Protocol > %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    ;

expr_ip_dscp:
      FLOW_IP_DSCP CMP_EQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_dscp == $3));
        _NDFP_debugf("IP DSCP == %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_IP_DSCP CMP_NOTEQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_dscp != $3));
        _NDFP_debugf("IP DSCP != %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    ;

