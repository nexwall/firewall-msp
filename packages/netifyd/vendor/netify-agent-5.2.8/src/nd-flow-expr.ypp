expr_tls_alpn_server:
      FLOW_TLS_ALPN_SERVER {
        _NDFP_result = ($$ = (!_NDFP_flow->tls.alpn_server.empty()));
    }
    | '!' FLOW_TLS_ALPN_SERVER {
        _NDFP_result = ($$ = (_NDFP_flow->tls.alpn_server.empty()));
    }
    | FLOW_TLS_ALPN_SERVER CMP_EQUAL VALUE_NAME {
        _NDFP_result = ($$ = false);
        size_t p; std::string search($3);
        while ((p = search.find_first_of("'\"")) != std::string::npos) search.erase(p, 1);
        for (auto &item : _NDFP_flow->tls.alpn_server) {
            if (strncasecmp(search.c_str(), item.c_str(), _NDFP_MAX_BUFLEN) == 0) {
                _NDFP_result = ($$ = true);
                break;
            }
        }
    }
    | FLOW_TLS_ALPN_SERVER CMP_NOTEQUAL VALUE_NAME {
        _NDFP_result = ($$ = true);
        size_t p; std::string search($3);
        while ((p = search.find_first_of("'\"")) != std::string::npos) search.erase(p, 1);
        for (auto &item : _NDFP_flow->tls.alpn_server) {
            if (strncasecmp(search.c_str(), item.c_str(), _NDFP_MAX_BUFLEN) == 0) {
                _NDFP_result = ($$ = false);
                break;
            }
        }
    }
    | FLOW_TLS_ALPN_SERVER CMP_EQUAL VALUE_REGEX {
        _NDFP_result = ($$ = false);
        std::string rx($3);
        for (auto &item : _NDFP_flow->tls.alpn_server) {
            if (_NDFP_regex_search(rx, item)) {
                _NDFP_result = ($$ = true);
                break;
            }
        }
    }
    | FLOW_TLS_ALPN_SERVER CMP_NOTEQUAL VALUE_REGEX {
        _NDFP_result = ($$ = true);
        std::string rx($3);
        for (auto &item : _NDFP_flow->tls.alpn_server) {
            if (_NDFP_regex_search(rx, item)) {
                _NDFP_result = ($$ = false);
                break;
            }
        }
    }
    ;

