        _NDFP_result = ($$ = ((_NDFP_flow->origin == ndFlow::Origin::LOWER ?
          _NDFP_flow->stats.upper_rate.load() : _NDFP_flow->stats.lower_rate.load()) < $3));
#else
        _NDFP_result = ($$ = (0 < $3));
#endif
    }
    ;

