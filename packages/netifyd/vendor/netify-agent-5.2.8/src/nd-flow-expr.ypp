    | FLOW_IFACE CMP_EQUAL VALUE_NAME {
        _NDFP_result = ($$ = false);
        if (!_NDFP_flow->iface->ifname.empty()) {
            size_t p;
            string search($3);

            while ((p = search.find_first_of("'\"")) != string::npos)
                search.erase(p, 1);

            if (strncasecmp(search.c_str(),
                _NDFP_flow->iface->ifname.c_str(), _NDFP_MAX_BUFLEN) == 0) {
                _NDFP_result = ($$ = true);
