        _NDFP_result = ($$ = (
            strncasecmp(
                _NDFP_src_mac->GetString().c_str(), $3, ND_STR_ETHALEN) != 0
        ));
        _NDFP_debugf("Source MAC != %s? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
