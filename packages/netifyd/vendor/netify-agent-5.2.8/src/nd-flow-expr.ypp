          _NDFP_flow->stats.lower_rate.load() : _NDFP_flow->stats.upper_rate.load()) > $3));
#else
        _NDFP_result = ($$ = (0 > $3));
#endif
    }
    | FLOW_SRC_RATE '<' VALUE_FLOAT {
#ifdef _ND_ENABLE_EXTENDED_STATS
        _NDFP_result = ($$ = ((_NDFP_flow->origin == ndFlow::Origin::LOWER ?
          _NDFP_flow->stats.lower_rate.load() : _NDFP_flow->stats.upper_rate.load()) < $3));
#else
        _NDFP_result = ($$ = (0 < $3));
#endif
    }
    ;

expr_dst_rate:
      FLOW_DST_RATE CMP_EQUAL VALUE_FLOAT {
#ifdef _ND_ENABLE_EXTENDED_STATS
        _NDFP_result = ($$ = ((_NDFP_flow->origin == ndFlow::Origin::LOWER ?
          _NDFP_flow->stats.upper_rate.load() : _NDFP_flow->stats.lower_rate.load()) == $3));
#else
        _NDFP_result = ($$ = (0 == $3));
#endif
    }
    | FLOW_DST_RATE CMP_NOTEQUAL VALUE_FLOAT {
#ifdef _ND_ENABLE_EXTENDED_STATS
        _NDFP_result = ($$ = ((_NDFP_flow->origin == ndFlow::Origin::LOWER ?
          _NDFP_flow->stats.upper_rate.load() : _NDFP_flow->stats.lower_rate.load()) != $3));
#else
        _NDFP_result = ($$ = (0 != $3));
#endif
    }
    | FLOW_DST_RATE CMP_GTHANEQUAL VALUE_FLOAT {
#ifdef _ND_ENABLE_EXTENDED_STATS
        _NDFP_result = ($$ = ((_NDFP_flow->origin == ndFlow::Origin::LOWER ?
          _NDFP_flow->stats.upper_rate.load() : _NDFP_flow->stats.lower_rate.load()) >= $3));
#else
        _NDFP_result = ($$ = (0 >= $3));
#endif
    }
    | FLOW_DST_RATE CMP_LTHANEQUAL VALUE_FLOAT {
#ifdef _ND_ENABLE_EXTENDED_STATS
        _NDFP_result = ($$ = ((_NDFP_flow->origin == ndFlow::Origin::LOWER ?
          _NDFP_flow->stats.upper_rate.load() : _NDFP_flow->stats.lower_rate.load()) <= $3));
#else
        _NDFP_result = ($$ = (0 <= $3));
#endif
    }
    | FLOW_DST_RATE '>' VALUE_FLOAT {
#ifdef _ND_ENABLE_EXTENDED_STATS
        _NDFP_result = ($$ = ((_NDFP_flow->origin == ndFlow::Origin::LOWER ?
          _NDFP_flow->stats.upper_rate.load() : _NDFP_flow->stats.lower_rate.load()) > $3));
#else
        _NDFP_result = ($$ = (0 > $3));
#endif
    }
