value_addr_ip:
      VALUE_ADDR_IPV4 { strncpy($$, $1, _NDFP_MAX_BUFLEN); }
    | VALUE_ADDR_IPV4_CIDR { strncpy($$, $1, _NDFP_MAX_BUFLEN); }
    | VALUE_ADDR_IPV6 { strncpy($$, $1, _NDFP_MAX_BUFLEN); }
    | VALUE_ADDR_IPV6_CIDR { strncpy($$, $1, _NDFP_MAX_BUFLEN); }
    ;

expr_any_port:
      FLOW_ANY_PORT {
        _NDFP_result = ($$ = (_NDFP_local_port != 0));
        if (!_NDFP_result)
            _NDFP_result = ($$ = (_NDFP_other_port != 0));
        _NDFP_debugf("Any port is true? %s\n", (_NDFP_result) ? "yes" : "no");
    }
    | '!' FLOW_ANY_PORT {
        _NDFP_result = ($$ = (_NDFP_local_port == 0));
        if (!_NDFP_result)
            _NDFP_result = ($$ = (_NDFP_other_port == 0));
        _NDFP_debugf("Any port is false? %s\n", (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_ANY_PORT CMP_EQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_local_port == $3));
        if (!_NDFP_result)
            _NDFP_result = ($$ = (_NDFP_other_port == $3));
        _NDFP_debugf("Any port == %lu %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_ANY_PORT CMP_NOTEQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_local_port != $3));
        if (!_NDFP_result)
            _NDFP_result = ($$ = (_NDFP_other_port != $3));
        _NDFP_debugf("Any port != %lu %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_ANY_PORT CMP_GTHANEQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_local_port >= $3));
        if (!_NDFP_result)
            _NDFP_result = ($$ = (_NDFP_other_port >= $3));
        _NDFP_debugf("Any port >= %lu %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_ANY_PORT CMP_LTHANEQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_local_port <= $3));
        if (!_NDFP_result)
            _NDFP_result = ($$ = (_NDFP_other_port <= $3));
        _NDFP_debugf("Any port <= %lu %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_ANY_PORT '>' VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_local_port > $3));
        if (!_NDFP_result)
            _NDFP_result = ($$ = (_NDFP_other_port > $3));
        _NDFP_debugf("Any port > %lu %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_ANY_PORT '<' VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_local_port < $3));
        if (!_NDFP_result)
            _NDFP_result = ($$ = (_NDFP_other_port < $3));
        _NDFP_debugf("Any port > %lu %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    ;

