    | FLOW_IP_VERSION CMP_GTHANEQUAL VALUE_UNSIGNED {
        _NDFP_result = ($$ = (_NDFP_flow->ip_version >= $3));
        _NDFP_debugf("IP version >= %lu? %s\n", $3, (_NDFP_result) ? "yes" : "no");
