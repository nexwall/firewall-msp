expr_any_mac:
      FLOW_ANY_MAC CMP_EQUAL VALUE_ADDR_MAC {
        _NDFP_result = ($$ = (
            strncasecmp(
                _NDFP_local_mac->GetString().c_str(), $3, ND_STR_ETHALEN) == 0
        ));

        if (!_NDFP_result) {
            _NDFP_result = ($$ = (
                strncasecmp(
                    _NDFP_other_mac->GetString().c_str(), $3, ND_STR_ETHALEN) == 0
            ));
        }

        _NDFP_debugf("Any MAC == MAC %s? %s\n", $3, (_NDFP_result) ? "yes" : "no");
    }
    | FLOW_ANY_MAC CMP_NOTEQUAL VALUE_ADDR_MAC {
        _NDFP_result = ($$ = (
            strncasecmp(_NDFP_local_mac->GetString().c_str(), $3, ND_STR_ETHALEN) != 0
        ));

        if (!_NDFP_result) {
