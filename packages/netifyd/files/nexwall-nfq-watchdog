# SPDX-License-Identifier: GPL-2.0-only
#
# Detects a stuck packet queue and recovers from it.
#
# netifyd (queues 50-57) and snort (queues 4-7) read packets from NFQUEUE. If a queue has packets waiting and its
# verdict counter does not move, or a large backlog stays in the queue (the reader is alive but far too slow),
# everything hashed to that queue stalls: new connections to or through the firewall hang while others keep
# working. The nftables "bypass" flag does not help, it only applies when no program is listening.
#
# Runs from cron every minute and takes three samples 10 seconds apart. A queue is stalled when packets are waiting
# in all three samples and (a) its verdict counter did not move, or (b) at least BACKLOG packets are waiting in
# every sample. On a stall it saves diagnostics to /root/nfq-stall/<time>/, logs a critical message and restarts
# the owner of the queue, at most once every 10 minutes.
#
# Test hooks: NFQ_FILE (queue file), DRY_RUN=1 (diagnostics and log only, no restart), SAMPLE_WAIT (seconds), BACKLOG.
#

NFQ_FILE="${NFQ_FILE:-/proc/net/netfilter/nfnetlink_queue}"
DUMP_ROOT="${DUMP_ROOT:-/root/nfq-stall}"
STATE="${STATE:-/tmp/nfq-watchdog.last}"
WAIT="${SAMPLE_WAIT:-10}"
BACKLOG="${BACKLOG:-64}"
COOLDOWN=600
KEEP=10

[ -r "$NFQ_FILE" ] || exit 0

snap() {
    # sample index, queue, packets waiting, verdict sequence
    awk -v n="$1" '$1 >= 4 && $1 <= 57 { print n, $1, $3, $8 }' "$NFQ_FILE"
}

# stalled queues: packets waiting in every sample, and either no verdict progress between the first and the last
# sample, or a sustained backlog of BACKLOG packets or more
stalled=$( { snap 1; sleep "$WAIT"; snap 2; sleep "$WAIT"; snap 3; } | awk -v backlog="$BACKLOG" '
    { tot[$2, $1] = $3; seq[$2, $1] = $4; q[$2] = 1 }
    END {
        for (k in q) {
            if (!(tot[k, 1] > 0 && tot[k, 2] > 0 && tot[k, 3] > 0)) continue
            if (seq[k, 1] == seq[k, 3] ||
                (tot[k, 1] >= backlog && tot[k, 2] >= backlog && tot[k, 3] >= backlog))
                print k
        }
    }' | sort -n)

[ -n "$stalled" ] || exit 0

services=""
for q in $stalled; do
    if [ "$q" -ge 50 ]; then s=netifyd; else s=snort; fi
    case " $services " in *" $s "*) ;; *) services="$services $s" ;; esac
done

now=$(date +%s)
last=$(cat "$STATE" 2>/dev/null)
[ -n "$last" ] || last=0
if [ $((now - last)) -lt "$COOLDOWN" ]; then
    logger -t nexwall-nfq-watchdog -p daemon.err "queue(s) $(echo $stalled) stalled again within ${COOLDOWN}s, not restarting"
    exit 0
fi
echo "$now" > "$STATE"

dir="$DUMP_ROOT/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$dir"
{
    date
    uptime
    echo "stalled queues: $(echo $stalled)"
    echo "services:$services"
    echo; echo "== nfnetlink_queue"; cat "$NFQ_FILE"
    echo; echo "== free"; free
    echo; echo "== conntrack"; cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null
    echo; echo "== top"; top -bn1 2>/dev/null | head -20
    echo; echo "== loopback sockets (Recv-Q/Send-Q of the flows and stats daemons)"; netstat -tn 2>/dev/null | grep -E "127.0.0.1:(8080|8081)|Recv-Q"
    echo; echo "== processes"; ps | grep -E "netifyd|snort|ns-flows|ns-stats|nethsecurity|banip|telegraf|victoria" | grep -v grep
    for s in $services; do
        for pid in $(pidof "$s"); do
            echo; echo "== $s $pid threads (tid state utime stime wchan syscall-and-futex-address)"
            for t in /proc/$pid/task/*; do
                echo "$(basename $t) $(awk '{print $3, $14, $15}' $t/stat 2>/dev/null) $(cat $t/wchan 2>/dev/null) | $(cut -d' ' -f1-3 $t/syscall 2>/dev/null)"
            done
            echo "-- maps of the executable and libraries (for offline symbolisation)"
            grep -E "r-xp" /proc/$pid/maps 2>/dev/null | awk '{print $1, $6}' | head -40
        done
    done
    echo; echo "== nft netifyd"; nft list table inet netifyd 2>&1
    echo; echo "== dmesg"; dmesg | tail -40
} > "$dir/report.txt" 2>&1

logger -t nexwall-nfq-watchdog -p daemon.crit "queue(s) $(echo $stalled) stalled, owner:$services, diagnostics in $dir"

[ -n "$DRY_RUN" ] && exit 0

for s in $services; do
    /etc/init.d/$s restart >/dev/null 2>&1
    logger -t nexwall-nfq-watchdog -p daemon.crit "restarted $s"
done

# keep the newest dumps only
ls -1d "$DUMP_ROOT"/*/ 2>/dev/null | sort | head -n -"$KEEP" | while read -r old; do rm -rf "$old"; done
exit 0
