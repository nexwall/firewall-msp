#
# Detects a stuck packet queue and recovers from it.
#
# netifyd (queues 50-57) and snort (queues 4-7) read packets from NFQUEUE. If a queue has packets waiting and its
# verdict counter does not move, everything hashed to that queue stalls: new connections to or through the
# firewall hang while others keep working. The nftables "bypass" flag does not help, it only applies when no
# program is listening.
#
# Runs from cron every minute and takes three samples 10 seconds apart. On a stall it saves diagnostics to
# /root/nfq-stall/<time>/, logs a critical message and restarts the owner of the queue, at most once every 10 minutes.
#
# Test hooks: NFQ_FILE (queue file), DRY_RUN=1 (diagnostics and log only, no restart), SAMPLE_WAIT (seconds).
#

NFQ_FILE="${NFQ_FILE:-/proc/net/netfilter/nfnetlink_queue}"
DUMP_ROOT="${DUMP_ROOT:-/root/nfq-stall}"
STATE="${STATE:-/tmp/nfq-watchdog.last}"
WAIT="${SAMPLE_WAIT:-10}"
COOLDOWN=600
KEEP=10

[ -r "$NFQ_FILE" ] || exit 0

snap() {
    # sample index, queue, packets waiting, verdict sequence
    awk -v n="$1" '$1 >= 4 && $1 <= 57 { print n, $1, $3, $8 }' "$NFQ_FILE"
}

# stalled queues: packets waiting in every sample, no verdict progress between first and last
stalled=$( { snap 1; sleep "$WAIT"; snap 2; sleep "$WAIT"; snap 3; } | awk '
    { tot[$2, $1] = $3; seq[$2, $1] = $4; q[$2] = 1 }
    END {
        for (k in q)
            if (tot[k, 1] > 0 && tot[k, 2] > 0 && tot[k, 3] > 0 && seq[k, 1] == seq[k, 3])
                print k
    }' | sort -n)

[ -n "$stalled" ] || exit 0

services=""
for q in $stalled; do
    if [ "$q" -ge 50 ]; then s=netifyd; else s=snort; fi
    case " $services " in *" $s "*) ;; *) services="$services $s" ;; esac
done

now=$(date +%s)
last=$(cat "$STATE" 2>/dev/null)
[ -n "$last" ] || last=0
if [ $((now - last)) -lt "$COOLDOWN" ]; then
    logger -t nexwall-nfq-watchdog -p daemon.err "queue(s) $(echo $stalled) stalled again within ${COOLDOWN}s, not restarting"
    exit 0
fi
echo "$now" > "$STATE"

dir="$DUMP_ROOT/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$dir"
{
    date
    uptime
    echo "stalled queues: $(echo $stalled)"
    echo "services:$services"
    echo; echo "== nfnetlink_queue"; cat "$NFQ_FILE"
    echo; echo "== free"; free
    echo; echo "== conntrack"; cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null
    echo; echo "== ps"; ps
    for s in $services; do
        for pid in $(pidof "$s"); do
            echo; echo "== $s $pid threads (name state wchan)"
            for t in /proc/$pid/task/*; do
                echo "$(cat $t/comm 2>/dev/null) $(awk '{print $3}' $t/stat 2>/dev/null) $(cat $t/wchan 2>/dev/null)"
            done
        done
    done
    echo; echo "== nft netifyd"; nft list table inet netifyd 2>&1
    echo; echo "== dmesg"; dmesg | tail -40
} > "$dir/report.txt" 2>&1

logger -t nexwall-nfq-watchdog -p daemon.crit "queue(s) $(echo $stalled) stalled, owner:$services, diagnostics in $dir"

[ -n "$DRY_RUN" ] && exit 0

for s in $services; do
    /etc/init.d/$s restart >/dev/null 2>&1
    logger -t nexwall-nfq-watchdog -p daemon.crit "restarted $s"
done

# keep the newest dumps only
ls -1d "$DUMP_ROOT"/*/ 2>/dev/null | sort | head -n -"$KEEP" | while read -r old; do rm -rf "$old"; done
exit 0
