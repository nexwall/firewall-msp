
config netifyd
	option enabled 1

	# Auto-configuration for interfaces (internal/external, -I/-E passive
	# capture) is OFF by default: capture is via NFQUEUE (see
	# /etc/netifyd/interfaces.d/10-nfqueue.conf and ns-netifyd-configure),
	# generic firewall chain hooks, not tied to any specific interface -
	# enabling this too would redundantly ALSO run passive capture
	# alongside it. Only turn this on for a specific supplementary need
	# (internal_if/external_if below), e.g. a VPN tunnel interface NFQUEUE
	# does not naturally cover.
	option autoconfig 0

	# Supplementary options, ex: disable connection tracking thread (-t)
	#list options '-t'
	#list options '--thread-detection-cores=2'

	# Manual configuration of internal interfaces and options
	#list internal_if 'br-lan -F "not (udp and dst 239.255.255.250 and dst port 1900)"'
	#list internal_if 'eth0 -A 192.168.1.1/24'

	# Manual configuration of external interfaces and options
	#list external_if 'eth1'
	#list external_if 'ppp0 -N eth2'

# Packet queue watchdog (nexwall-nfq-watchdog, run by cron every minute): recovers the DPI/IPS engines when a
# kernel packet queue stops being served.
#   enabled      0 disables it completely
#   restart      0 keeps detection, report and alert but never restarts a service
#   max_restarts most restarts per hour, above that it only reports and alerts
#   backlog      packets waiting in every 10 s sample that count as a stall
config watchdog 'watchdog'
	option enabled '1'
	option restart '1'
	option max_restarts '3'
	option backlog '64'

# Management access to the firewall itself is never sent to the analysis engine (only traffic addressed to or
# sent by the firewall, forwarded traffic is unaffected). Default TCP ports: 22 443 9090. To change it, create
# the settings section (type "config", name "config") and set the list, use 'none' to analyze them too:
#config config 'config'
#	list mgmt_ports '22'
#	list mgmt_ports '443'
#	list mgmt_ports '9090'
