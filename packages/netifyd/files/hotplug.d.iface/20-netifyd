#
# Keeps the traffic classification engine's LAN/WAN device list in sync with
# the firewall zones whenever an interface changes - a WAN configured after
# first boot, a device swapped, a zone edited. See ns-netifyd-configure.

[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ] || exit 0

if /usr/sbin/ns-netifyd-configure; then
	# restart, not reload: the vendor's own reload_service only sends a signal,
	# and -I/-E are startup command-line arguments, rebuilt only when the
	# process actually restarts
	/etc/init.d/netifyd restart
fi

exit 0
