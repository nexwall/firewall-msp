#!/bin/sh /etc/rc.common

#
# Copyright (C) 2026 Nexwall
# SPDX-License-Identifier: GPL-2.0-only
#
# The flow scorer of Advanced Threat Protection (see /usr/sbin/nexwall-atp). It is started only while the switch is on
# (Protection services > Advanced and Collective Protection); the license is checked by the service itself.

START=95
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get nexwall_atp.main.enabled)" = "0" ] && return 0
	procd_open_instance
	procd_set_param command /usr/sbin/nexwall-atp daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nexwall_atp
}
