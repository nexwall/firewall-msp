# Advanced Threat Protection: the signed model is checked and, when the administrator shares reports (the default), the report of remote
# indicators is sent, every 30 minutes with a random delay. Both steps do their own checks (license, switch, minimum interval).
crontab -l 2>/dev/null | grep -q 'nexwall-atp sync' || \
    echo '*/30 * * * * sleep $(( RANDOM % 600 )); /usr/sbin/nexwall-atp sync >/dev/null 2>&1' >> /etc/crontabs/root
exit 0
