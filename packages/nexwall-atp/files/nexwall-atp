"""nexwall-atp: the flow scorer of Advanced Threat Protection on the firewall (phase 5b of the ATP roadmap, docs/FIREWALL-ATP.md in nexwall/nexwall-atp).

It reads the flows the DPI engine already keeps (`ubus call ns.flows list`) and the DNS names the inner networks ask (a read-only packet view), keeps them
for a few windows in bounded memory, and scores every host against the model file on the unit. A host at `review` or `high` level becomes an advisory event
with the evidence in words; nothing is blocked and nothing leaves the unit.

  nexwall-atp daemon     the service (procd): one scoring cycle every `interval` seconds, at low priority
  nexwall-atp once       one cycle from the flows now (for tests and the lab)
  nexwall-atp status     JSON of the last state
  nexwall-atp update     download the signed model from the license server (verified; the previous model is kept)
  nexwall-atp rollback   go back to the previous model
  nexwall-atp report     send the consented report: remote indicators only (see below)
  nexwall-atp sync       update, then report (cron)

The report (step 4 of docs/FIREWALL-ATP.md) carries only remote parties: public addresses and domain names that flagged hosts contacted or asked, the kind of
evidence, the model version and the day. Never an internal address, a host name of the network, a user, a payload or a URL. It is sent when `share` is on
(the default; the wizard and the settings page say so next to the switch) and the unit is licensed.
Files (under /mnt/data/atp): model.json (the model; the signed download is a later step), events.jsonl (advisory events, one JSON per line, rotated at 1 MiB),
status.json. Settings: /etc/config/nexwall_atp (enabled, share, interval, max_hosts, budget).
Environment (tests): ATP_DIR, ATP_LIB, FLOWS_JSON (a file with the output of `ubus call ns.flows list`), ATP_NO_LICENSE=1 (skip the license check), ATP_CORE_CTL and ATP_PUBKEY (a stand-in for licensectl and the public key)."""
import base64
import hashlib
import ipaddress
import json
import os
import re
import subprocess
import sys
import time

LIB = os.environ.get('ATP_LIB', '/usr/lib/nexwall-atp')
sys.path.insert(0, LIB)

from atp.capture import flowlog          # noqa: E402
from atp.edge import model as M          # noqa: E402
from atp.edge import scorer as S         # noqa: E402

DIR = os.environ.get('ATP_DIR', '/mnt/data/atp')
MAX_EVENTS_BYTES = 1 << 20
LICENSE_RECHECK = 300
NICE = 10
CORE_CTL = os.environ.get('ATP_CORE_CTL', '/usr/sbin/licensectl')
PUBKEY = os.environ.get('ATP_PUBKEY', '/etc/nexwall-license/pubkey.pem')
UPDATE_MIN_INTERVAL = 25 * 60
REPORT_MIN_INTERVAL = 60 * 60
MAX_REPORT_INDICATORS = 100
# top-level names that belong to private networks: a name under them is never reported
PRIVATE_TLDS = {'local', 'lan', 'internal', 'intranet', 'home', 'corp', 'private', 'localdomain', 'localhost', 'arpa', 'example', 'test', 'invalid', 'home.arpa'}
DOMAIN_RE = re.compile(r'^(?=.{4,253}$)(?:[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?\.)+[a-z0-9-]{2,63}$')
VERSION_RE = re.compile(r'^\d{4}\.\d{2}\.\d{2}\.\d{1,3}$')


def uci(key, default):
    try:
        p = subprocess.run(['uci', '-q', 'get', key], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return default
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else default


def settings():
    def num(key, default, cast):
        try:
            return cast(uci('nexwall_atp.main.' + key, default))
        except ValueError:
            return cast(default)
    return {'enabled': uci('nexwall_atp.main.enabled', '1') == '1', 'share': uci('nexwall_atp.main.share', '1') == '1', 'interval': max(10, num('interval', '60', int)),
            'max_hosts': max(1, num('max_hosts', '200', int)), 'budget': max(0.1, num('budget', '2.0', float))}


def licensed():
    """True when this unit may use the ATP module (subscription or trial)."""
    if os.environ.get('ATP_NO_LICENSE'):
        return True
    try:
        from nethsec import license as nx_license
        return nx_license.state() in ('subscribed', 'trial') and bool(nx_license.modules().get('atp'))
    except Exception:       # noqa: BLE001 - no answer is "not licensed": the unit never scores without knowing
        return False


def is_internal(ip):
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return False
    return a.is_private and not a.is_loopback and not a.is_link_local


FLOWS_URL = 'http://127.0.0.1:8080/flows'     # the flow daemon behind `ubus call ns.flows list`: every flow, no paging, no sorting
PAGE = 1000
MAX_PAGES = 50


def read_flows():
    """Every flow the DPI engine keeps, or None when nothing answers. `ns.flows list` answers one page of 10 flows by default, so the daemon is asked
    directly; when it does not answer, the pages of the ubus call are read one by one."""
    p = os.environ.get('FLOWS_JSON')
    if p:
        try:
            with open(p) as fp:
                return json.load(fp).get('flows', [])
        except (OSError, ValueError, AttributeError):
            return None
    try:
        import urllib.request
        with urllib.request.urlopen(FLOWS_URL, timeout=10) as r:
            flows = json.loads(r.read().decode()).get('flows')
        if isinstance(flows, list):
            return flows
    except Exception:       # noqa: BLE001 - fall back to the pages
        pass
    out = []
    try:
        for page in range(1, MAX_PAGES + 1):
            text = subprocess.run(['ubus', 'call', 'ns.flows', 'list', json.dumps({'per_page': PAGE, 'page': page})],
                                  capture_output=True, text=True, timeout=30).stdout
            d = json.loads(text)
            out += d.get('flows', [])
            if page >= int(d.get('last_page') or 1):
                break
    except (OSError, ValueError, subprocess.SubprocessError, AttributeError):
        return out or None
    return out


def own_addresses():
    """The addresses of the firewall itself (its own connections are not a host to score)."""
    try:
        out = subprocess.run(['ip', '-o', '-4', 'addr', 'show'], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return set()
    return {line.split()[3].split('/')[0] for line in out.splitlines() if len(line.split()) > 3}


def flow_records(entries, own=frozenset()):
    """ns.flows entries -> flow records of the internal hosts. `local_origin` only says that the local side opened the connection (it is true for
    nearly every flow), so it is not used; the firewall's own addresses and outside addresses are left out."""
    out = []
    for e in entries or []:
        f = e.get('flow') if isinstance(e, dict) else None
        if not isinstance(f, dict):
            continue
        rec = flowlog.normalise(f)
        if rec and rec['digest'] and is_internal(rec['local_ip']) and rec['local_ip'] not in own:
            out.append(rec)
    return out


def inner_devices():
    """Bridges and interfaces of the inner zones (LAN, guest, ...): every zone except the Internet-facing ones; tunnels are left to their own tools."""
    try:
        text = subprocess.run(['uci', '-q', 'show', 'firewall'], capture_output=True, text=True, timeout=10).stdout
        net = subprocess.run(['uci', '-q', 'show', 'network'], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    import re
    zones, cur = {}, None
    for line in text.splitlines():
        m = re.match(r"firewall\.(\w+)=zone", line)
        if m:
            cur = zones.setdefault(m.group(1), {'name': '', 'networks': []})
            continue
        m = re.match(r"firewall\.(\w+)\.(name|network)='?(.*?)'?$", line)
        if m and m.group(1) in zones:
            if m.group(2) == 'name':
                zones[m.group(1)]['name'] = m.group(3)
            else:
                zones[m.group(1)]['networks'] += re.findall(r"'([^']*)'", line.split('=', 1)[1]) or [m.group(3)]
    devs = {}
    for line in net.splitlines():
        m = re.match(r"network\.(\w+)\.(?:device|ifname)='?([\w.\-]+)'?$", line)
        if m:
            devs[m.group(1)] = m.group(2)
    out = []
    for z in zones.values():
        if re.match(r'(wan|internet|uplink)', z['name'], re.I) or re.search(r'ipsec|wireguard|^wg', z['name'], re.I):
            continue
        out += [devs[n] for n in z['networks'] if n in devs and not re.match(r'(wg|ipsec|tun)', devs[n])]
    return sorted(set(out))


def load_json(name):
    try:
        with open(os.path.join(DIR, name)) as fp:
            d = json.load(fp)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_json(name, obj):
    os.makedirs(DIR, exist_ok=True)
    tmp = os.path.join(DIR, name + '.tmp')
    with open(tmp, 'w') as fp:
        json.dump(obj, fp)
    os.replace(tmp, os.path.join(DIR, name))


def log(msg):
    print(msg, file=sys.stderr)
    try:
        subprocess.run(['logger', '-t', 'nexwall-atp', msg], check=False, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


# ---- signed model download (step 3): same trust chain as the threat feeds, the license server key the unit already holds
def fetch(path):
    p = subprocess.run([CORE_CTL, 'get', path], capture_output=True, timeout=600)
    if p.returncode != 0:
        raise RuntimeError('%s: %s' % (path, p.stderr.decode(errors='replace').strip() or 'request failed'))
    return p.stdout


def verify_manifest(resp, pubkey=None):
    from Crypto.Hash import SHA256
    from Crypto.PublicKey import RSA
    from Crypto.Signature import pkcs1_15
    with open(pubkey or PUBKEY, 'rb') as f:
        key = RSA.import_key(f.read())
    payload = base64.b64decode(resp['payload'])
    pkcs1_15.new(key).verify(SHA256.new(payload), base64.b64decode(resp['signature']))
    m = json.loads(payload)
    if m.get('kind') != 'atp-model':
        raise ValueError('not a model manifest')
    return m


def install_model(data, manifest):
    """Check the bytes against the signed manifest, then against the model rules, then switch: the previous model stays as model.prev.json."""
    want = manifest['files']['model.json']
    if len(data) != want['size'] or hashlib.sha256(data).hexdigest() != want['sha256']:
        raise ValueError('model.json does not match the signed manifest')
    os.makedirs(DIR, exist_ok=True)
    tmp = os.path.join(DIR, 'model.json.new')
    with open(tmp, 'wb') as fp:
        fp.write(data)
    try:
        m = M.load(tmp)
        if m['version'] != manifest['model']['model_version']:
            raise ValueError('the model says version %s, the manifest %s' % (m['version'], manifest['model']['model_version']))
    except (M.ModelError, KeyError) as e:
        os.remove(tmp)
        raise ValueError('refused: %s' % e)
    cur = os.path.join(DIR, 'model.json')
    if os.path.exists(cur):
        os.replace(cur, os.path.join(DIR, 'model.prev.json'))
    os.replace(tmp, cur)
    return m


def cmd_update(force=False, fetch_fn=None, now=None):
    """-> exit status: 0 ok or nothing new, 1 failed (the installed model stays), 2 nothing published, 3 not licensed or not entitled"""
    fetch_fn = fetch_fn or fetch
    now = int(now or time.time())
    st = load_json('update.json')
    if not licensed():
        st.update(last_check=now, last_result='not licensed')
        save_json('update.json', st)
        return 3
    if not force and now - st.get('last_check', 0) < UPDATE_MIN_INTERVAL and st.get('version'):
        return 0
    try:
        resp = json.loads(fetch_fn('/api/v1/atp/manifest'))
        if not resp.get('entitled'):
            st.update(last_check=now, last_result='server: not entitled (%s)' % resp.get('license_state'))
            save_json('update.json', st)
            return 3
        if not resp.get('payload'):
            st.update(last_check=now, last_result='no model published yet')
            save_json('update.json', st)
            return 2
        manifest = verify_manifest(resp)
        version = manifest['version']
        if not VERSION_RE.match(version):
            raise ValueError('bad version')
        if st.get('version') == version and os.path.exists(os.path.join(DIR, 'model.json')):
            st.update(last_check=now, last_result='ok %s' % version, last_error=None)
            save_json('update.json', st)
            return 0
        install_model(fetch_fn('/api/v1/atp/file/%s/model.json' % version), manifest)
        st.update(version=version, model_version=manifest['model']['model_version'], last_check=now, last_result='installed %s' % version, last_error=None)
        save_json('update.json', st)
        log('model %s installed' % version)
        return 0
    except Exception as e:      # noqa: BLE001 - the installed model stays whatever happens here
        st.update(last_check=now, last_result='update failed', last_error=str(e)[:300])
        save_json('update.json', st)
        log('update failed: %s' % e)
        return 1


def cmd_rollback():
    prev, cur = os.path.join(DIR, 'model.prev.json'), os.path.join(DIR, 'model.json')
    if not os.path.exists(prev):
        print('no previous model', file=sys.stderr)
        return 1
    M.load(prev)
    os.replace(prev, cur)
    st = load_json('update.json')
    st.update(version=None, last_result='rolled back')       # the next update installs the published version again
    save_json('update.json', st)
    return 0


# ---- consented report (step 4): remote indicators only
def public_ip(value):
    try:
        a = ipaddress.ip_address(value)
    except ValueError:
        return False
    return a.version == 4 and a.is_global and not a.is_multicast


def public_domain(value):
    v = str(value).strip().lower()
    return bool(DOMAIN_RE.match(v)) and v.rsplit('.', 1)[-1] not in PRIVATE_TLDS and not public_ip(v)


def read_events(since):
    out = []
    for name in ('events.jsonl.1', 'events.jsonl'):
        try:
            with open(os.path.join(DIR, name)) as fp:
                for line in fp:
                    try:
                        ev = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(ev, dict) and ev.get('ts', 0) >= since:
                        out.append(ev)
        except OSError:
            pass
    return out


def build_report(events, now, model_version=''):
    """The report document from the advisory events of the last day. Only remote indicators; the host of an event is never read."""
    best = {}
    for ev in events:
        for ind in ev.get('indicators') or []:
            if not isinstance(ind, dict):
                continue
            if ind.get('type') == 'ip' and public_ip(ind.get('value', '')):
                key, evidence, score = ('ip', ind['value']), 'beacon', ind.get('beacon', 0)
            elif ind.get('type') == 'domain' and public_domain(ind.get('value', '')):
                key, evidence, score = ('domain', str(ind['value']).lower()), 'generated-name', ind.get('dga', 0)
            else:
                continue
            if key not in best or score > best[key][1]:
                best[key] = (evidence, score)
    items = sorted(best.items(), key=lambda kv: -kv[1][1])[:MAX_REPORT_INDICATORS]
    return {'version': 1, 'day': time.strftime('%Y-%m-%d', time.gmtime(now)), 'model_version': model_version,
            'indicators': [{'type': k[0], 'value': k[1], 'evidence': ev, 'score': round(float(sc), 2)} for k, (ev, sc) in items]}


def post(path, doc):
    p = subprocess.run([CORE_CTL, 'post', path], input=json.dumps(doc).encode(), capture_output=True, timeout=120)
    if p.returncode != 0:
        raise RuntimeError('%s: %s' % (path, p.stderr.decode(errors='replace').strip() or 'request failed'))
    return p.stdout


def cmd_report(force=False, post_fn=None, now=None):
    """-> exit status: 0 sent or nothing to send, 1 failed, 3 sharing is off or the unit is not licensed. Nothing leaves the unit unless sharing is on."""
    post_fn = post_fn or post
    now = int(now or time.time())
    cfg = settings()
    st = load_json('report.json')
    if not cfg['share'] or not cfg['enabled'] or not licensed():
        return 3
    if not force and now - st.get('last_try', 0) < REPORT_MIN_INTERVAL:
        return 0
    st['last_try'] = now
    try:
        model = M.load(os.path.join(DIR, 'model.json'))['version']
    except (M.ModelError, OSError):
        model = ''
    doc = build_report(read_events(now - 86400), now, model)
    if not doc['indicators']:
        save_json('report.json', st)
        return 0
    digest = hashlib.sha256(json.dumps([doc['day'], doc['indicators']], sort_keys=True).encode()).hexdigest()
    if digest == st.get('last_digest'):
        save_json('report.json', st)
        return 0
    try:
        post_fn('/api/v1/atp/report', doc)
        st.update(last_digest=digest, last_sent=now, last_result='sent %d indicator(s)' % len(doc['indicators']), last_error=None)
        save_json('report.json', st)
        return 0
    except Exception as e:      # noqa: BLE001 - tried again at the next sync
        st.update(last_result='failed', last_error=str(e)[:300])
        save_json('report.json', st)
        log('report failed: %s' % e)
        return 1


class Service:
    def __init__(self, cfg=None, clock=time.time):
        self.cfg, self.clock = cfg or settings(), clock
        self.scorer, self.model_mtime, self.sniffer = None, None, None
        self.last = {}          # host -> (level rank, ts) of the last event written
        self.own, self.own_at = set(), 0.0
        self.entitled = True
        self.stats = {'cycles': 0, 'flows_read': 0, 'dns_records': 0, 'events_total': 0, 'last_cycle_ms': 0.0, 'last_error': None}

    # ---- model
    def model_path(self):
        return os.path.join(DIR, 'model.json')

    def load_model(self):
        try:
            mt = os.stat(self.model_path()).st_mtime
        except OSError:
            self.scorer, self.model_mtime = None, None
            return None
        if self.scorer is not None and mt == self.model_mtime:
            return self.scorer.model
        try:
            m = M.load(self.model_path())
        except (M.ModelError, OSError) as e:
            self.stats['last_error'] = 'model: %s' % e
            self.scorer = None
            return None
        old = self.scorer
        self.scorer = S.Scorer(m, max_hosts=self.cfg['max_hosts'], budget_seconds=self.cfg['budget'])
        if old is not None:                    # a new model keeps what was seen: the features do not depend on it unless the window changed
            if old.model['window'] == m['window'] and old.model['history_windows'] == m['history_windows']:
                self.scorer.flows, self.scorer.dns = old.flows, old.dns
        self.model_mtime = mt
        return m

    # ---- one cycle
    def cycle(self, dns_records=()):
        t0 = time.monotonic()
        now = self.clock()
        if not self.load_model():
            self.write_status('no_model')
            return []
        entries = read_flows()
        if entries is None:
            self.stats['last_error'] = 'ns.flows did not answer'
            entries = []
        if now - self.own_at > LICENSE_RECHECK:
            self.own, self.own_at = own_addresses(), now
        recs = flow_records(entries, self.own)
        self.scorer.add_flows(recs)
        self.scorer.add_dns(list(dns_records))
        self.stats['flows_read'] += len(recs)
        self.stats['dns_records'] += len(dns_records)
        events = self.fresh(self.scorer.cycle(now), now)
        if events:
            self.write_events(events)
        self.stats['cycles'] += 1
        self.stats['events_total'] += len(events)
        self.stats['last_cycle_ms'] = round((time.monotonic() - t0) * 1000, 1)
        self.write_status('scoring')
        return events

    RANK = {'normal': 0, 'review': 1, 'high': 2}

    def fresh(self, events, now):
        """A host is written again when its level rises or when a window has passed (the event store merges equal events of one minute anyway)."""
        window = self.scorer.model['window']
        out = []
        for ev in events:
            r = self.RANK[ev['level']]
            prev = self.last.get(ev['host'])
            if prev is None or r > prev[0] or now - prev[1] >= window:
                self.last[ev['host']] = (r, now)
                out.append(ev)
        for h in [h for h, (_, ts) in self.last.items() if now - ts > 4 * window]:
            del self.last[h]
        return out

    # ---- files
    def write_events(self, events):
        os.makedirs(DIR, exist_ok=True)
        path = os.path.join(DIR, 'events.jsonl')
        try:
            if os.path.getsize(path) > MAX_EVENTS_BYTES:
                os.replace(path, path + '.1')
        except OSError:
            pass
        with open(path, 'a') as fp:
            for ev in events:
                fp.write(json.dumps(ev, sort_keys=True) + '\n')

    def write_status(self, state):
        m = self.scorer.model if self.scorer else None
        st = dict(self.stats, state=state, ts=int(self.clock()), enabled=self.cfg['enabled'], share=self.cfg.get('share', True), entitled=self.entitled, interval=self.cfg['interval'],
                  last_report=load_json('report.json').get('last_sent'), model_updated=load_json('update.json').get('last_result'), model=(m or {}).get('name'), model_version=(m or {}).get('version'),
                  hosts=len(self.scorer.flows) if self.scorer else 0,
                  dns_view=self.sniffer.interfaces() if self.sniffer else [])
        os.makedirs(DIR, exist_ok=True)
        tmp = os.path.join(DIR, 'status.json.tmp')
        with open(tmp, 'w') as fp:
            json.dump(st, fp)
        os.replace(tmp, os.path.join(DIR, 'status.json'))

    # ---- DNS view
    def start_sniffer(self):
        try:
            from atp.edge import dnssniff
            self.sniffer = dnssniff.Sniffer(inner_devices())
        except Exception as e:      # noqa: BLE001 - scoring continues without the DNS names
            self.sniffer = None
            self.stats['last_error'] = 'dns view: %s' % e


def daemon():
    try:
        os.nice(NICE)
    except OSError:
        pass
    svc = Service()
    svc.start_sniffer()
    ok_until, allowed, next_cycle = 0, False, 0
    dns = []
    while True:
        now = time.time()
        if now >= ok_until:
            svc.cfg = settings()
            svc.entitled = licensed()
            allowed = svc.cfg['enabled'] and svc.entitled
            ok_until = now + LICENSE_RECHECK
        if svc.sniffer and allowed:
            dns += svc.sniffer.poll(timeout=1.0)
        else:
            time.sleep(1.0)
        if now >= next_cycle:
            next_cycle = now + svc.cfg['interval']
            if allowed:
                try:
                    svc.cycle(dns)
                except Exception as e:      # noqa: BLE001 - one bad cycle must not stop the service
                    svc.stats['last_error'] = 'cycle: %s' % e
                dns = []
            else:
                svc.write_status('off' if not svc.cfg['enabled'] else 'not_licensed')


def main(argv):
    cmd = argv[1] if len(argv) > 1 else 'status'
    if cmd == 'daemon':
        daemon()
    elif cmd == 'once':
        svc = Service()
        print(json.dumps(svc.cycle(), indent=1))
    elif cmd == 'update':
        return cmd_update(force='--force' in argv)
    elif cmd == 'rollback':
        return cmd_rollback()
    elif cmd == 'report':
        return cmd_report(force='--force' in argv)
    elif cmd == 'sync':
        return 1 if 1 in (cmd_update(), cmd_report()) else 0
    elif cmd == 'status':
        try:
            with open(os.path.join(DIR, 'status.json')) as fp:
                print(fp.read())
        except OSError:
            print(json.dumps({'state': 'not_running'}))
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
