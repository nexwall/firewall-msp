# Retention of the hourly traffic reports. On the data partition (the normal case): RETENTION_DAYS days (default 35, uci
# ns-stats.daemon.retention_days) and at most 2% of the partition. Without a data partition the reports live in RAM:
# at most 1% of /tmp, oldest day first, as before.
BASE_DIR="$(readlink -f /var/run/dpireport)"
[ -d "$BASE_DIR" ] || exit 0

DAYS="$(uci -q get ns-stats.daemon.retention_days)"
case "$DAYS" in ''|*[!0-9]*) DAYS=35 ;; esac

if [ "$BASE_DIR" != "/var/run/dpireport" ] && grep -q ' /mnt/data ' /proc/mounts; then
    MAX_SIZE=$(( $(df -k /mnt/data | awk 'NR==2 {print $2}') / 50 ))   # 2% of the data partition
    # report folders are year/month/day: older than the retention goes first
    find "$BASE_DIR" -mindepth 3 -maxdepth 3 -type d -mtime +"$DAYS" -exec rm -rf {} + 2>/dev/null
    find "$BASE_DIR" -mindepth 1 -maxdepth 2 -type d -empty -delete 2>/dev/null
else
    MAX_SIZE=$(( $(df -k /tmp | awk 'NR==2 {print $2}') / 100 ))       # 1% of /tmp
fi

# size cap: delete the oldest day (never today) until it fits
while [ "$(du -sk "$BASE_DIR" | cut -f1)" -gt "$MAX_SIZE" ]; do
    to_be_deleted="$(find "$BASE_DIR" -daystart -mindepth 3 -maxdepth 3 -mtime +0 -type d -printf "%T+ %p\n" | sort | awk '{print $2}' | head -n 1)"
    if [ "$to_be_deleted" != "" ]; then
        rm -rf "$to_be_deleted"
    else
        exit 0
    fi
done
