# Manage netifyd sink

import os
import sys
import json
from nethsec import utils
import subprocess
import configparser

def status():
    uuid = ""
    if not os.path.exists("/etc/netifyd/agent.uuid"):
        # generate the uuid id not exists
        # agent UUIDs have the form XX-XX-XX-XX
        try:
            os.makedirs("/etc/netifyd", exist_ok=True)
            with open("/etc/netifyd/agent.uuid", "w") as f:
                f.write("-".join("%02X" % b for b in os.urandom(4)) + "\n")
        except:
            return utils.generic_error("failed_to_generate_uuid")

    try:
        with open("/etc/netifyd/agent.uuid", "r") as f:
            uuid = f.read().strip()
    except:
        return utils.generic_error("failed_to_read_uuid")

    config = configparser.ConfigParser()
    config.read('/etc/netifyd.conf')
    # auto_informatics is the real config key the agent itself reads and writes
    # (the earlier "enable_sink" key checked here was never a real netifyd.conf
    # key in any version of the agent - found live, see FORK-CHANGES.md). A
    # config this engine does not understand at all (for example restored from
    # a backup taken with a different netifyd package) is repaired by
    # netifyd-selfheal on the next service start; until then, report the sink
    # as disabled instead of failing the whole status card.
    if not config.has_section('netifyd') or not config.has_option('netifyd', 'auto_informatics'):
        return {"enabled": False, "uuid": uuid}
    auto_informatics = config.get('netifyd', 'auto_informatics')
    return {"enabled": auto_informatics == "yes", "uuid": uuid}

def enable():
    try:
        subprocess.run(["/usr/sbin/netifyd", "--enable-sink"], check=True, capture_output=True)
    except:
        return utils.generic_error("failed_to_enable_sink")
    return {"result": "success"}
    
def disable():
    try:
        subprocess.run(["/usr/sbin/netifyd", "--disable-sink"], check=True, capture_output=True)
    except:
        return utils.generic_error("failed_to_disable_sink")
    return {"result": "success"}

cmd = sys.argv[1]

if cmd == 'list':
    print(json.dumps({
        "enable": {},
        "disable": {},
        "status":{},
        }))
else:
    action = sys.argv[2]
    if action == "enable":
        ret = enable()
    elif action == "status":
        ret = status()
    elif action == "disable":
        ret = disable()

    print(json.dumps(ret))
