#
# Threat shield IP: add the address categories of the Nexwall threat feeds to banip (local files downloaded by
# nexwall-threat-feeds from the license server).
#

TMP_FEEDS=/tmp/ts-ip.feeds
if /usr/sbin/nexwall-threat-feeds feeds-ip > "$TMP_FEEDS" 2>/dev/null && jq -e . "$TMP_FEEDS" >/dev/null 2>&1; then
    jq -s '.[0] * .[1]' "$TMP_FEEDS" /etc/banip/banip.feeds > /etc/banip/banip.custom.feeds.new && mv /etc/banip/banip.custom.feeds.new /etc/banip/banip.custom.feeds
else
    # keep the previous definitions on a transient failure; without any, banip uses its own list
    [ -f /etc/banip/banip.custom.feeds ] || : > /etc/banip/banip.custom.feeds
fi
rm -f "$TMP_FEEDS"
