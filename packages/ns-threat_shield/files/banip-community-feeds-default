# Ships with a sensible default set of banIP's own free, well-established
# community feeds enabled out of the box, so IP-based threat blocking gives
# real baseline protection from first boot rather than requiring an admin
# to know to turn it on. The original NethSecurity design leaves this
# entirely unset by default (no feed is pre-selected) - this is our own
# product decision, not a reproduction of their behavior.
#
# Chosen for low false-positive risk and established reputation, not
# breadth: Spamhaus DROP, the SANS/DShield list, Firehol's own "safe to
# auto-block" level-1 compilation, GreenSnow, and bruteforceblocker -
# nothing here is Nethesis- or Yoroi-specific, all free community feeds
# banIP already ships support for.

[ -n "$(uci -q get banip.global.ban_feed)" ] && exit 0

uci -q batch << EOI
add_list banip.global.ban_feed="spamhaus"
add_list banip.global.ban_feed="dshield"
add_list banip.global.ban_feed="firehol1"
add_list banip.global.ban_feed="greensnow"
add_list banip.global.ban_feed="bruteforceblock"
commit banip
EOI

exit 0
