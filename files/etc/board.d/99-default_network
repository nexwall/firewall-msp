# Default network of a board that has no script of its own (virtual machines, generic x86 boxes): the first
# network card is the LAN and the second one is the WAN, asking for an address by DHCP. A board script that defined
# a LAN but left the WAN out gets the same WAN, so a firewall plugged into a modem works at once and the setup
# wizard finds the internet connection already there. (Units that were started before this was fixed get their WAN from
# uci-defaults/99-nethsec-default-wan.)

. /lib/functions/uci-defaults.sh

board_config_update

# This script runs in the pre-init phase, before the network card drivers are loaded (on a virtual machine they are modules), so
# /sys/class/net does not list eth1 yet: the second card is assumed. On a box with only one card the WAN interface just stays down.
if json_is_a network object; then
	json_select network
	json_get_type _has_wan wan
	json_select ..
	[ -z "$_has_wan" ] && ucidef_set_interface_wan 'eth1' 'dhcp'
else
	ucidef_set_interface_lan 'eth0'
	ucidef_set_interface_wan 'eth1' 'dhcp'
fi

board_config_flush

exit 0
